        <mxCell id="kiEgvd8khefzqftrXf_k-44" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=16;" value="ARQUITECTURA TO-BE&lt;br&gt;Proceso de Prestamos" vertex="1">
          <mxGeometry height="53" width="275" x="304" y="119" as="geometry" />
        </mxCell>
        <mxCell id="kiEgvd8khefzqftrXf_k-37" parent="1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;aspect=fixed;" value="&lt;div&gt;6&lt;/div&gt;" vertex="1">
          <mxGeometry height="32" width="32" x="852" y="320.99486033519554" as="geometry" />
        </mxCell>
        <mxCell id="kiEgvd8khefzqftrXf_k-47" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th align=&quot;right&quot;&gt;Paso&lt;/th&gt;&lt;th&gt;Interacción&lt;/th&gt;&lt;th&gt;Descripción&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td align=&quot;right&quot;&gt;&lt;strong&gt;1&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;&lt;font face=&quot;Helvetica&quot;&gt;Usuario - APISIX&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font face=&quot;Helvetica&quot;&gt;El usuario consume la solución mediante operaciones &lt;code&gt;POST&lt;/code&gt; o &lt;code&gt;GET&lt;/code&gt;. Todo el tráfico ingresa por APISIX, que actúa como único punto de entrada.&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;right&quot;&gt;&lt;strong&gt;&lt;font face=&quot;Helvetica&quot;&gt;2&lt;/font&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;&lt;font face=&quot;Helvetica&quot;&gt;APISIX - Loan API&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font face=&quot;Helvetica&quot;&gt;APISIX valida el JWT, aplica las políticas de seguridad y tráfico, genera o propaga el identificador de correlación y enruta la solicitud hacia Loan API.&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;right&quot;&gt;&lt;strong&gt;&lt;font face=&quot;Helvetica&quot;&gt;3&lt;/font&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;&lt;font face=&quot;Helvetica&quot;&gt;Loan API - Cloud SQL&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font face=&quot;Helvetica&quot;&gt;Loan API valida la solicitud y controla la idempotencia. Para una nueva operación registra &lt;code&gt;loan_operation&lt;/code&gt; y &lt;code&gt;outbox_event&lt;/code&gt; en la misma transacción. Para una consulta obtiene el estado asociado al &lt;code&gt;operationId&lt;/code&gt;.&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;right&quot;&gt;&lt;strong&gt;&lt;font face=&quot;Helvetica&quot;&gt;4&lt;/font&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;&lt;font face=&quot;Helvetica&quot;&gt;Cloud SQL / Outbox - Pub/Sub&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font face=&quot;Helvetica&quot;&gt;El evento registrado en el outbox es publicado en Pub/Sub para desacoplar la aceptación de la solicitud del procesamiento efectivo del desembolso.&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;right&quot;&gt;&lt;strong&gt;&lt;font face=&quot;Helvetica&quot;&gt;5&lt;/font&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;&lt;font face=&quot;Helvetica&quot;&gt;Pub/Sub - Loan Processor Worker&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font face=&quot;Helvetica&quot;&gt;Pub/Sub entrega el evento al Worker para que la operación continúe de manera asíncrona, sin mantener bloqueada la solicitud original del usuario.&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;right&quot;&gt;&lt;strong&gt;&lt;font face=&quot;Helvetica&quot;&gt;6&lt;/font&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;&lt;font face=&quot;Helvetica&quot;&gt;Loan Processor Worker - INARI / ADMWR&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font face=&quot;Helvetica&quot;&gt;El Worker invoca el sistema de desembolso y procesa la operación manteniendo la correlación con el &lt;code&gt;operationId&lt;/code&gt; original.&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;right&quot;&gt;&lt;strong&gt;&lt;font face=&quot;Helvetica&quot;&gt;7&lt;/font&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;&lt;font face=&quot;Helvetica&quot;&gt;Worker - Pub/Sub / Retry Policy&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font face=&quot;Helvetica&quot;&gt;Si el procesamiento falla, el mensaje no se confirma y Pub/Sub aplica la política de reintentos configurada. Esto evita que el cliente tenga que volver a ejecutar la operación.&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;right&quot;&gt;&lt;strong&gt;&lt;font face=&quot;Helvetica&quot;&gt;8&lt;/font&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;&lt;font face=&quot;Helvetica&quot;&gt;Loan Processor Worker - Cloud SQL&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font face=&quot;Helvetica&quot;&gt;El Worker actualiza el estado final o intermedio de la operación para que pueda ser consultado posteriormente mediante &lt;code&gt;GET /loans/{operationId}&lt;/code&gt;.&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="399" width="615" x="1009" y="195" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
